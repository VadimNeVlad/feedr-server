DATABASE_URL=postgresql://user:password@localhost:5432/feeds
JWT_SECRET=replace-with-at-least-32-random-characters
PORT=3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Number of reverse proxies in front of the app (1 behind the nginx gateway).
# Leave unset when the app is reached directly; ignored on Vercel (always 1).
# TRUST_PROXY=1
CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
